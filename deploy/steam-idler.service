[Unit]
Description=Steam game idler
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=steam-idler
Group=steam-idler
WorkingDirectory=/opt/steam-idler
Environment=NODE_ENV=production
EnvironmentFile=/etc/steam-idler.env
ExecStart=/usr/bin/node /opt/steam-idler/src/main.js
Restart=always
RestartSec=10
RestartPreventExitStatus=78
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/steam-idler

[Install]
WantedBy=multi-user.target
